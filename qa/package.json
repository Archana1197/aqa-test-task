{
  "name": "vikunja-qa-automation",
  "version": "1.0.0",
  "description": "QA Automation tests for Vikunja application using TypeScript and Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:parallel": "playwright test --workers=3",
    "test:local": "set TEST_ENV=local&& playwright test",
    "test:staging": "set TEST_ENV=staging&& playwright test",
    "test:production": "set TEST_ENV=production&& playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "keywords": ["qa", "automation", "playwright", "typescript"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^2.4.3",
    "mysql2": "^3.15.2",
    "typescript": "^5.3.0"
  }
}
