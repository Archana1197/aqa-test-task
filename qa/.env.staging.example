TEST_ENV=staging
BASE_URL=https://staging.example.com
STAGING_BASE_URL=https://staging.example.com

PW_WORKERS=4
PW_RETRIES=2
PW_TIMEOUT_MS=90000
PW_ACTION_TIMEOUT_MS=20000

FEATURE_DB_SEEDING=true
FEATURE_PARALLEL_EXECUTION=true
FEATURE_RESOURCE_POOLING=true
FEATURE_DIAGNOSTICS=true
FEATURE_METRICS=true
FEATURE_HEALTH_SAMPLING=true
HEALTH_SAMPLE_INTERVAL_MS=15000

ENABLE_TEST_DATA_CLEANUP=true
TEST_USER_PREFIX=e2e_user_

DB_HOST=staging-db.internal
DB_PORT=3306
DB_USER=vikunja
DB_PASSWORD=change-me
DB_NAME=vikunja
DB_POOL_LIMIT=20
DB_SEED_USER_SQL=INSERT INTO users (username, email, password, created, updated) VALUES (?, ?, ?, NOW(), NOW())
DB_CLEANUP_USER_SQL=DELETE FROM users WHERE email = ?

HEALTH_ENDPOINT=/api/v1/info
METRICS_OUTPUT_PATH=test-results/enterprise-metrics.json
BENCHMARK_THRESHOLD_MS=6000
ENTERPRISE_METRICS_WEBHOOK=
